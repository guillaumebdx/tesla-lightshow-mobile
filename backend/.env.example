# OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# OpenAI model for light show generation (v1 engine only)
OPENAI_MODEL=gpt-4.1-mini

# Light show engine: v2 (default, beat-locked) or v1 (previous generator, rollback)
SHOW_ENGINE=v2
# v2 designer: model + reasoning effort (low | medium | high) + timeout per attempt (1 retry,
# rule-based plan only if both fail). Long generations are fine: the route keeps the response alive.
SHOW_DESIGNER_MODEL=gpt-5.5
SHOW_DESIGNER_REASONING=medium
SHOW_DESIGNER_TIMEOUT_MS=120000
# v2 designer: "llm" (default) or "rules" (no API call, deterministic)
SHOW_DESIGNER=llm

# OpenAI model for support chat AI drafts (can differ from show generation)
OPENAI_CHAT_MODEL=gpt-4.1-nano

# Firebase service account JSON path (relative to backend/)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Server port
PORT=3001

# Allowed origin (your app's domain, or * for dev)
CORS_ORIGIN=*

# Node environment (development = skip App Check)
NODE_ENV=development

# Admin password for /admin routes
ADMIN_PASSWORD=your-secret-password-here

# VAPID keys for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@lightstudio.harari.ovh
